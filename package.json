{
  "name": "saints-church",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Josh Reeder-Esparza <joshre@me.com>",
  "license": "MIT",
  "scripts": {
    "build": "./build.js",
    "build:prod": "./build.js && yarn tailwindcss -i _css/input.css -o css/output.css --minify",
    "watch": "concurrently \"./build.js --watch\" \"bundle exec jekyll serve --livereload --incremental\" \"yarn tailwindcss -i _css/input.css -o css/output.css --minify --watch\"",
    "generate-icons": "node scripts/generate-icons.js",
    "update-icons": "git submodule update --remote assets/heroicons && yarn generate-icons",
    "generate-taxonomies": "npx tsx scripts/generate-taxonomies.ts",
    "lint": "yarn lint:types && yarn lint:js && yarn lint:css && yarn lint:md && yarn lint:yaml && yarn lint:tw",
    "lint:types": "tsc --noEmit",
    "lint:js": "biome check js/ scripts/ build.js",
    "format": "biome check --write js/ scripts/ build.js",
    "lint:css": "stylelint '_css/**/*.css'",
    "lint:md": "markdownlint '_posts/**/*.md' 'beliefs.md' 'pastor-letter.md' 'sermons.md' --ignore node_modules",
    "lint:yaml": "yamllint _data/ _config.yml",
    "lint:tw": "rustywind --check-formatted _includes/ _layouts/ index.md beliefs.md pastor-letter.md sermons.md"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "concurrently": "^9.2.0",
    "estrella": "^1.4.1",
    "markdownlint-cli": "^0.48.0",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tailwindplus/elements": "^1.0.9",
    "js-yaml": "^4.1.1",
    "rss-parser": "^3.13.0"
  },
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshre/saints-church.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/joshre/saints-church/issues"
  },
  "homepage": "https://github.com/joshre/saints-church#readme"
}
